{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phasetr/lattice-system/blueprint/schema.json",
  "title": "LatticeSystem Tasaki bootstrap blueprint",
  "type": "object",
  "required": ["schemaVersion", "source", "phase", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "const": "tasaki-2020" },
    "phase": { "const": "bootstrap-empty" },
    "records": { "type": "array", "maxItems": 0 }
  },
  "additionalProperties": false
}
